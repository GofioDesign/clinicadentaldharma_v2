# Cabeceras para Cloudflare Pages (se ignoran en GitHub Pages).

# Que Google no indexe la copia en *.pages.dev, solo clinicadentaldharma.com
https://:project.pages.dev/*
  X-Robots-Tag: noindex

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Las fuentes no cambian nunca: caché de un año
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes: caché de un día (si cambias una foto, se verá como tarde al día siguiente)
/img/*
  Cache-Control: public, max-age=86400

/clinica-dental-dharma.vcf
  Content-Type: text/vcard; charset=utf-8

# Archivos internos que no deben aparecer en Google
/_plantilla-articulo/*
  X-Robots-Tag: noindex
/README.md
  X-Robots-Tag: noindex
